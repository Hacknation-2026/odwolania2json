# LLM po API zgodnym z OpenAI. OpenRouter = placeholder na czas developmentu.
# Do zgłoszenia: dostawca z serwerami w UE/EOG + model open-weight (np. Mistral API: https://api.mistral.ai/v1).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Na OpenRouter tylko darmowe modele (sufiks :free). Lista: https://openrouter.ai/models?q=free
LLM_MODEL=google/gemma-4-31b-it:free
LLM_TEMPERATURE=0
# true = wymuszanie JSON Schema (structured outputs); gdy model go nie obsługuje, klient sam
# przełącza się na tryb json_object (schemat i opis pól są wtedy tylko w prompcie)
LLM_STRUCTURED_OUTPUT=true

# Klasyfikacja: poniżej tej pewności dokument trafia do "brak" (pusty JSON)
MIN_CONFIDENCE=0.5

# OCR dla stron bez warstwy tekstowej
OCR_ENABLED=true
OCR_MIN_CHARS=50
